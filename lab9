class Rectangle:
    def __init__(self, length, width):
        self.length = length
        self.width = width

    def area(self):
        """Возвращает площадь прямоугольника"""
        return self.length * self.width

    def perimeter(self):
        """Возвращает периметр прямоугольника"""
        return 2 * (self.length + self.width)
